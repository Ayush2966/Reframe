# Optional: enables "AI upscale in the cloud" (Topaz Video Upscale on Replicate).
# Get a token at https://replicate.com/account/api-tokens. Usage is billed to that account.
REPLICATE_API_TOKEN=

# Optional: extra host names Reframe should answer on (comma separated), e.g. a
# custom domain in front of it. localhost and this Mac's Tailscale name always work.
REFRAME_HOSTS=

# Optional: contact for push services (an email, or an https:// URL).
PUSH_CONTACT=
